{
  "expo": {
    "name": "Edorapad",
    "slug": "edorapad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "edorapad",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edorapad.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.392496995218-omkl6b17bgvrh5u8o8rdddtifoss7vjc",
              "edorapad"
            ]
          }
        ],
        "NSCameraUsageDescription": "Edorapad requires camera access for identity verification and profile photos.",
        "NSMicrophoneUsageDescription": "Edorapad requires microphone access for online live lecture participation.",
        "NSPhotoLibraryUsageDescription": "Edorapad requires photo library access to upload documents and profile images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E7B74",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.edorapad.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Edorapad requires camera access for identity verification and profile photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3E7B74"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "owner": "g344",
    "extra": {
      "eas": {
        "projectId": "0fb21980-9cf5-41f0-bfa6-e6a24ac0bfed"
      }
    }
  }
}
